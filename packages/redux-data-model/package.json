{
  "name": "redux-data-model",
  "version": "0.15.0",
  "description": "Opinionated, Redux abstraction with built-in immutability, normalization, and selectors support.",
  "author": "Lucas Lira Gomes <llira@kayak.com>",
  "homepage": "https://kayak.github.io/redux-data-model/",
  "license": "Apache-2.0",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "typings": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayak/redux-data-model.git"
  },
  "scripts": {
    "clean": "rimraf dist js_coverage .rpt2_cache",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc",
    "test": "jest --silent",
    "test:logs": "jest",
    "test:update": "npm run test -- -u",
    "test:watch": "npm run test -- --watchAll --verbose",
    "test:coverage": "npm run test -- --verbose --coverage",
    "coveralls": "coveralls",
    "build": "npm run lint && npm run lint:tsc && npm run test && npm run build:tsc",
    "build:tsc": "tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.types.json",
    "size": "npm run build && size-limit"
  },
  "bugs": {
    "url": "https://github.com/kayak/redux-data-model/issues"
  },
  "peerDependencies": {
    "immer": "^6.0.1",
    "lodash": "^4.17.20",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-redux": ">=4.4.9",
    "redux-saga": "^1.0.5",
    "reselect": "^4.0.0",
    "tslib": "^2.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "react-test-renderer": "^18.3.1",
    "redux-mock-store": "^1.5.4",
    "ts-jest": "^29.4.11"
  }
}
